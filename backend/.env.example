# --- App ---
APP_NAME="ShadowPulse API"
APP_VERSION="1.0.0"
ENV="development"

# --- MongoDB ---
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="shadowpulse"

# --- Auth / Security ---
SECRET_KEY="CHANGE_ME_IN_PRODUCTION_use_a_long_random_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Agent ingest auth ---
AGENT_API_KEY="CHANGE_ME_AGENT_SHARED_SECRET"

# --- ML / Threat scoring ---
ANOMALY_CONTAMINATION=0.05
THREAT_THRESHOLD_ALERT=60.0

# --- SMS Notification ---
SMS_ENABLED=false
SMS_MODE="mock" # "mock" or "live"
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
ALERT_PHONE_NUMBER=""
